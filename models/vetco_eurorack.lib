+ RC=1          CJC=33.3p  VJC=0.651  MJC=0.389  FC=0.5
+ CJE=99.5p     VJE=0.778  MJE=0.380
+ TR=0          TF=796p  RB=122 )


* ================================================================
* SECTION 2: JUNCTION FIELD-EFFECT TRANSISTORS (JFET)
*
* All models use standard ngspice NJF/PJF .model syntax.
* Physical pin order (TO-92): 1=Drain  2=Gate  3=Source
* ================================================================

* ----------------------------------------------------------------
* NTE457 — N-Channel JFET General Purpose  (2N5457 equivalent)
*   VGS(off)=-6V max  IDSS=1–5mA  VDS=25V  fT=100MHz
*   Use: CV control; VCRs in filters; simple VCAs.
*   Source: Central Semiconductor 2N5457 SPICE model.
* ----------------------------------------------------------------
.MODEL NTE457 NJF(
+ VTO=-1.4676  BETA=1.6275m  LAMBDA=0.883m
+ RD=1         RS=1
+ CGS=4.5p     CGD=1.5p
+ PB=1         FC=0.5       IS=35.7p
+ KF=9.9E-18   AF=1 )

* ----------------------------------------------------------------
* NTE458 — N-Channel JFET Low-Noise Audio  (J201 / 2N4117 equiv.)
*   VGS(off)=-0.3 to -1.5V  IDSS=0.2–1mA  VDS=50V
*   Use: Low-noise audio input stages; primary audio path.
*   Source: InterFET J201 SPICE model parameters.
* ----------------------------------------------------------------
.MODEL NTE458 NJF(
+ VTO=-0.80    BETA=1.0m    LAMBDA=10m
+ RD=50        RS=50
+ CGS=25p      CGD=5p
+ PB=0.5       FC=0.5       IS=1E-14
+ KF=1E-18     AF=1 )

* ----------------------------------------------------------------
* NTE467 — N-Channel JFET Switching  (2N5458 equivalent)
*   VGS(off)=-7V max  IDSS=2–9mA  VDS=30V
*   Use: S&H circuits; analog switches (low Rds(on)).
*   Source: Published 2N5458 SPICE model.
* ----------------------------------------------------------------
.MODEL NTE467 NJF(
+ VTO=-2.882   BETA=0.489m  LAMBDA=3.167m
+ RD=1         RS=1
+ CGS=4.627p   CGD=4p
+ PB=1         FC=0.5       IS=181.3E-15
+ KF=9.9E-18   AF=1 )

* ----------------------------------------------------------------
* NTE489 — P-Channel JFET  (2N5462 equivalent)
*   VGS(off)=+3 to +7.5V  IDSS=4–16mA  VDS=30V  Ic=50mA
*   Use: Complementary P-channel; push-pull output stages.
*   Source: Vishay Siliconix 2N5462 SPICE parameters.
* ----------------------------------------------------------------
.MODEL NTE489 PJF(
+ VTO=3.50     BETA=0.65m   LAMBDA=5m
+ RD=1         RS=1
+ CGS=5p       CGD=2p
+ PB=1         FC=0.5       IS=35.7p )

* ----------------------------------------------------------------
* VET469 — N-Channel JFET High-Current  (NTE469)
*   VGS(off)=-0.5 to -4V  IDSS(max)=30mA (NTE469)  VDS=35V
*   Use: Driving heavier loads; "chopper" circuits.
*   Source: NTE469 datasheet (equivalent: PN4393, BSJ113, J113);
*           BETA scaled for IDSS=30mA at VGS=0 (BETA = IDSS / VTO^2 = 30m/4 = 7.5m).
* ----------------------------------------------------------------
.MODEL VET469 NJF(
+ VTO=-2.00    BETA=7.5m    LAMBDA=8m
+ RD=20        RS=20
+ CGS=4p       CGD=2p
+ PB=1         FC=0.5       IS=1E-14 )

* ----------------------------------------------------------------
* NTE460 — P-Channel JFET  (2N5460-type, 20V variant)
*   VGS(off)=+0.75 to +6V  IDSS=1–5mA  VDS=20V
*   Use: Low-voltage sub-sections (0–10V); caution on ±12V rails.
*   Source: 2N5460 parameters de-rated to 20V operation.
* ----------------------------------------------------------------
.MODEL NTE460 PJF(
+ VTO=2.50     BETA=0.5m    LAMBDA=5m
+ RD=1         RS=1
+ CGS=4p       CGD=1.5p
+ PB=0.75      FC=0.5       IS=35.7p )

* ----------------------------------------------------------------
* NTE326 — P-Channel JFET High-Voltage  (2N5460-type, 40V)
*   VGS(off)=+0.75 to +9V  IDSS=1–5mA  VDS=40V
*   Use: Full Eurorack rail swing; safe for 24V differential.
*   Source: 2N5460 parameters calibrated for full 40V operation.
* ----------------------------------------------------------------
.MODEL NTE326 PJF(
+ VTO=3.50     BETA=0.25m   LAMBDA=4m
+ RD=1         RS=1
+ CGS=4p       CGD=1.5p
+ PB=1         FC=0.5       IS=35.7p )


* ================================================================
* SECTION 3: OPERATIONAL AMPLIFIERS
*
* Single-section parts (LM741N, NTE976) have 5-pin subcircuits:
*   Pin 1 = Non-Inverting Input  (IN+)
*   Pin 2 = Inverting Input      (IN-)
*   Pin 3 = Positive Supply      (V+)
*   Pin 4 = Negative Supply      (V-)
*   Pin 5 = Output               (OUT)
*
* Multi-section parts (dual/quad) expose a package-level wrapper
* with named pins (VCC VEE INA_P INA_N OUTA ...) that internally
* instantiate <Name>_SEC cores sharing the supply rails.
*
* Boyle-type macro models (IEEE J. Solid-State Circuits, 1974).
* GBW is set by GA / (2*pi*C2); slew rate by IEE / C2.
* VLP/VLN set the maximum output excursion from the rails.
*
* ================================================================

* ----------------------------------------------------------------
* LM741N — Single Op-Amp  (Texas Instruments / National Semi.)
*   Avol≈106dB  GBW=1MHz  SR=0.5V/µs  Rails=±18V  Iout=25mA
*   Use: Vintage/lo-fi oscillators; distortion circuits.
*   Source: Classic Boyle macro model; TI data sheet parameters.
* ----------------------------------------------------------------
.SUBCKT LM741N 1 2 3 4 5
*               IN+ IN- V+ V- OUT
*
C1   11 12 8.661E-12
C2    6  7 30.00E-12
DC    5 53 DX
DE   54  5 DX
DLP  90 91 DX
DLN  92 90 DX
DP    4  3 DX
EGND 99  0 VALUE = {0.5*V(3) + 0.5*V(4)}
FB1   7 99 VB  21.22E6
FB2   7 99 VC -20E6
FB3   7 99 VE  20E6
FB4   7 99 VLP 20E6
FB5   7 99 VLN -20E6
GA    6  0 11 12 188.5E-6
GCM   0  6 10 99 5.961E-9
IEE  10  4 DC 15.16E-6
HLIM 90  0 VLIM 1K
Q1   11  2 13 QX
Q2   12  1 14 QX
R2    6  9 100.0E3
RC1   3 11 5.305E3
RC2   3 12 5.305E3
RE1  13 10 1.836E3
RE2  14 10 1.836E3
REE  10 99 13.19E6
RO1   8  5 50
RO2   7 99 25
RP    3  4 18.16E3
VB    9  0 DC 0
VC    3 53 DC 1
VE   54  4 DC 1
VLIM  7  8 DC 0
VLP  91  0 DC 40
VLN   0 92 DC 40
.MODEL DX D(IS=800.0E-18 RS=1)
.MODEL QX NPN(IS=800.0E-18 BF=93.75)
.ENDS LM741N

* ----------------------------------------------------------------
* LM358N — Dual Op-Amp  (Texas Instruments)  DIP-8, 2 sections
*   Avol≈100dB  GBW≈700kHz  SR=0.3V/µs  Rails=±16V or 3–32V single
*   Use: CV utility; LFOs, envelopes, comparators, logic.
*   Source: Analog Devices-hosted legacy LM358 macromodel
*           (legacy National/Standard Linear model; user-supplied source URL:
*           https://www.analog.com/en/products/lmx358.html).
*   NOTE: Wrapped to local 5-pin section order IN+ IN- V+ V- OUT.
*         This vendor macro gives a much more realistic output-current limit
*         than the prior Boyle fit. VIPM/VINM are lightly bench-tuned so the
*         source side breaks near +30mA while the sink side breaks just above
*         -20mA on +/-12V rails.
* ----------------------------------------------------------------
.SUBCKT LM358N_VENDOR_RAW 1 2 3 4 5
*                       IN- IN+ OUT V+ V-
.MODEL MDTH D IS=1E-8 KF=3.104131E-15 CJO=10F
* INPUT STAGE
CIP 2 5 1.000000E-12
CIN 1 5 1.000000E-12
EIP 10 5 2 5 1
EIN 16 5 1 5 1
RIP 10 11 2.600000E+01
RIN 15 16 2.600000E+01
RIS 11 15 2.003862E+02
DIP 11 12 MDTH AREA=400E-12
DIN 15 14 MDTH AREA=400E-12
VOFP 12 13 DC 0
VOFN 13 14 DC 0
IPOL 13 5 1.000000E-05
CPS 11 15 3.783376E-09
DINN 17 13 MDTH AREA=400E-12
VIN 17 5 0.000000e+00
DINR 15 18 MDTH AREA=400E-12
VIP 4 18 2.000000E+00
FCP 4 5 VOFP 3.400000E+01
FCN 5 4 VOFN 3.400000E+01
FIBP 2 5 VOFN 2.000000E-03
FIBN 5 1 VOFP 2.000000E-03
* AMPLIFYING STAGE
FIP 5 19 VOFP 3.600000E+02
FIN 5 19 VOFN 3.600000E+02
RG1 19 5 3.652997E+06
RG2 19 4 3.652997E+06
CC 19 5 6.000000E-09
DOPM 19 22 MDTH AREA=400E-12
DONM 21 19 MDTH AREA=400E-12
HOPM 22 28 VOUT 7.500000E+03
VIPM 28 4 2.200000E+02
HONM 21 27 VOUT 7.500000E+03
VINM 5 27 1.520000E+02
EOUT 26 23 19 5 1
VOUT 23 5 0
ROUT 26 3 20
COUT 3 5 1.000000E-12
DOP 19 25 MDTH AREA=400E-12
VOP 4 25 2.242230E+00
DON 24 19 MDTH AREA=400E-12
VON 24 5 7.922301E-01
.ENDS LM358N_VENDOR_RAW

.SUBCKT LM358N_SEC 1 2 3 4 5
*                   IN+ IN- V+ V- OUT
XCORE 2 1 5 3 4 LM358N_VENDOR_RAW
.ENDS LM358N_SEC

* LM358N package wrapper — dual, shared VCC/VEE
.SUBCKT LM358N VCC VEE INA_P INA_N OUTA INB_P INB_N OUTB
XA INA_P INA_N VCC VEE OUTA LM358N_SEC
XB INB_P INB_N VCC VEE OUTB LM358N_SEC
.ENDS LM358N

* --- High-Fidelity Open-Collector Comparator Model ---
.SUBCKT LM393_SEC 1 2 3 4 5
* Pins: IN+ IN- VCC VEE OUT
Q1 6 2 8 QPNP
Q2 7 1 8 QPNP
R1 6 4 10k
R2 7 4 10k
C_INT1 6 4 1p
C_INT2 7 4 1p
I1 3 8 DC 100u
G1 4 10 7 6 10m
R3 10 4 1Meg
C_INT3 10 4 1p
Q3 5 10 4 QNPN
.model QPNP pnp(bf=100)
.model QNPN npn(bf=100)
.ends LM393_SEC

* ----------------------------------------------------------------
* NTE987 — Quad Low-Power Op-Amp  (LM324 equiv.)  DIP-14, 4 sections
*   Avol≈100dB  GBW=1MHz  SR=0.5V/µs  Rails=±16V or 3–32V single
*   Use: Dense CV processors; mixers, attenuverters (4 sections/chip).
*   Source: Boyle macro model with LM324 input-stage parameters.
* ----------------------------------------------------------------
.SUBCKT NTE987_SEC 1 2 3 4 5
*                   IN+ IN- V+ V- OUT
*
C1   11 12 5.544E-12
C2    6  7 30.00E-12
DC    5 53 DX
DE   54  5 DX
DLP  90 91 DX
DLN  92 90 DX
DP    4  3 DX
EGND 99  0 VALUE = {0.5*V(3) + 0.5*V(4)}
FB1   7 99 VB  10.61E6
FB2   7 99 VC -20E6
FB3   7 99 VE  20E6
FB4   7 99 VLP 20E6
FB5   7 99 VLN -20E6
GA    6  0 11 12 188.5E-6
GCM   0  6 10 99 7.067E-9
IEE   3 10 DC 15.00E-6
HLIM 90  0 VLIM 1K
Q1   11  2 13 QX
Q2   12  1 14 QX
R2    6  9 100.0E3
RC1   11  4 5.305E3
RC2   12  4 5.305E3
RE1  13 10 1.836E3
RE2  14 10 1.836E3
REE  10 99 13.19E6
RO1   8  5 50
RO2   7 99 25
RP    3  4 20.00E3
VB    9  0 DC 0
VC    3 53 DC 2.0
VE   54  4 DC 0.2
VLIM  7  8 DC 0
VLP  91  0 DC 40
VLN   0 92 DC 40
.MODEL DX D(IS=800.0E-18 RS=1)
.MODEL QX PNP(IS=800.0E-18 BF=62.50)
.ENDS NTE987_SEC

* NTE987 package wrapper — quad, shared VCC/VEE
.SUBCKT NTE987 VCC VEE INA_P INA_N OUTA INB_P INB_N OUTB INC_P INC_N OUTC IND_P IND_N OUTD
XA INA_P INA_N VCC VEE OUTA NTE987_SEC
XB INB_P INB_N VCC VEE OUTB NTE987_SEC
XC INC_P INC_N VCC VEE OUTC NTE987_SEC
XD IND_P IND_N VCC VEE OUTD NTE987_SEC
.ENDS NTE987

* ----------------------------------------------------------------
* NTE976— Single High-Impedance Op-Amp  (TL071 / LF351 type)
*   Avol≈106dB  GBW=4MHz  SR=13V/µs  Rin≈10^12Ω  Rails=±18V
*   Use: Sample & Hold buffers; anything needing ultra-high-Z input.
*   Source: Boyle macro model with JFET input stage (TL071 params).
* ----------------------------------------------------------------
.SUBCKT NTE976 1 2 3 4 5
*               IN+ IN- V+ V- OUT
*
C1   11 12 3.498E-12
C2    6  7 10.00E-12
DC    5 53 DX
DE   54  5 DX
DLP  90 91 DX
DLN  92 90 DX
DP    4  3 DX
EGND 99  0 VALUE = {0.5*V(3) + 0.5*V(4)}
FB1   7 99 VB  21.22E6
FB2   7 99 VC -40E6
FB3   7 99 VE  40E6
FB4   7 99 VLP 40E6
FB5   7 99 VLN -40E6
GA    6  0 11 12 250.0E-6
GCM   0  6 10 99 1.0E-9
IEE  10  4 DC 100.0E-6
HLIM 90  0 VLIM 1K
J1   11  2 13 JX
J2   12  1 14 JX
R2    6  9 100.0E3
RD1   3 11 5.305E3
RD2   3 12 5.305E3
RS1  13 10 2.273E3
RS2  14 10 2.273E3
RSS  10 99 5.0E6
RO1   8  5 50
RO2   7 99 25
RP    3  4 18.0E3
VB    9  0 DC 0
VC    3 53 DC 1.5
VE   54  4 DC 1.5
VLIM  7  8 DC 0
VLP  91  0 DC 40
VLN   0 92 DC 40
.MODEL DX D(IS=800.0E-18 RS=1)
.MODEL JX NJF(IS=12.50E-12 BETA=250E-6 VTO=-1)
.ENDS NTE976

* ----------------------------------------------------------------
* OPA350 — Single High-Speed Rail-to-Rail CMOS Op-Amp  (TI)
*   Avol≈100dB  GBW=38MHz  SR=22V/µs  Rin≈10^13Ω  V+=2.7–5.5V
*
*   *** WARNING: NOT SUITABLE for standard ±12V Eurorack rails. ***
*   *** Maximum supply is ±2.75V equivalent (5.5V total).       ***
*   *** Use only in 0–5V or other low-voltage sub-sections.     ***
*
*   Source: Behavioral Boyle-style macromodel fit to TI OPA350
*           datasheet parameters. TI publishes an OPA350 PSpice
*           model, but this simplified local macro is tuned for the
*           shared ngspice library conventions used in this repo.
* ----------------------------------------------------------------
.SUBCKT OPA350 1 2 3 4 5
*               IN+ IN- V+ V- OUT
*
C1   11 12 2.0E-12
C2    6  7 5.00E-12
DC    5 53 DX
DE   54  5 DX
DLP  90 91 DX
DLN  92 90 DX
DP    4  3 DX
EGND 99  0 VALUE = {0.5*V(3) + 0.5*V(4)}
FB1   7 99 VB  4.409E6
FB2   7 99 VC -20E6
FB3   7 99 VE  20E6
FB4   7 99 VLP 20E6
FB5   7 99 VLN -20E6
GA    6  0 11 12 1.194E-3
GCM   0  6 10 99 6.31E-8
IEE  10  4 DC 110.0E-6
HLIM 90  0 VLIM 1K
J1   11  2 13 JX
J2   12  1 14 JX
R2    6  9 100.0E3
RD1   3 11 2.0E3
RD2   3 12 2.0E3
RS1  13 10 1.0E3
RS2  14 10 1.0E3
RSS  10 99 5.0E6
RO1   8  5 35
RO2   7 99 20
RP    3  4 20.0E3
VB    9  0 DC 0
VC    3 53 DC 0.02
VE   54  4 DC 0.02
VLIM  7  8 DC 0
VLP  91  0 DC 12
VLN   0 92 DC 12
.MODEL DX D(IS=800.0E-18 RS=1)
.MODEL JX NJF(IS=12.50E-12 BETA=1.0E-3 VTO=-0.5)
.ENDS OPA350

* ----------------------------------------------------------------
* LMC6482 — CMOS Rail-to-Rail Quad Op-Amp  (TI)  DIP-14, 4 sections
*   Avol≈84dB  GBW=1.5MHz  SR=2.7V/µs  Rin≈1TΩ  V+=2.7–16V
*
*   *** WARNING: NOT SUITABLE for standard ±12V Eurorack rails. ***
*   *** Maximum supply is ±8V (16V total).                       ***
*   *** Use only in 0–10V or low-voltage sub-sections.           ***
*
*   Source: Behavioral Boyle model; CMOS JFET-input stage; tight
*           output clamps (VC=VE=50mV) for rail-to-rail swing.
* ----------------------------------------------------------------
.SUBCKT LMC6482_SEC 1 2 3 4 5
*                    IN+ IN- V+ V- OUT
*
C1   11 12 2.0E-12
C2    6  7 21.2E-12
DC    5 53 DX
DE   54  5 DX
DLP  90 91 DX
DLN  92 90 DX
DP    4  3 DX
EGND 99  0 VALUE = {0.5*V(3) + 0.5*V(4)}
FB1   7 99 VB  1.681E6
FB2   7 99 VC -20E6
FB3   7 99 VE  20E6
FB4   7 99 VLP 20E6
FB5   7 99 VLN -20E6
GA    6  0 11 12 200.0E-6
GCM   0  6 10 99 1.0E-12
IEE  10  4 DC 100.0E-6
HLIM 90  0 VLIM 1K
J1   11  2 13 JX
J2   12  1 14 JX
R2    6  9 100.0E3
RD1   3 11 5.0E3
RD2   3 12 5.0E3
RS1  13 10 2.0E3
RS2  14 10 2.0E3
RSS  10 99 5.0E6
RO1   8  5 75
RO2   7 99 25
RP    3  4 30.0E3
VB    9  0 DC 0
VC    3 53 DC 0.05
VE   54  4 DC 0.05
VLIM  7  8 DC 0
VLP  91  0 DC 20
VLN   0 92 DC 20
.MODEL DX D(IS=800.0E-18 RS=1)
.MODEL JX NJF(IS=12.50E-12 BETA=500E-6 VTO=-0.5)
.ENDS LMC6482_SEC

* LMC6482 package wrapper — quad, shared VCC/VEE
.SUBCKT LMC6482 VCC VEE INA_P INA_N OUTA INB_P INB_N OUTB INC_P INC_N OUTC IND_P IND_N OUTD
XA INA_P INA_N VCC VEE OUTA LMC6482_SEC
XB INB_P INB_N VCC VEE OUTB LMC6482_SEC
XC INC_P INC_N VCC VEE OUTC LMC6482_SEC
XD IND_P IND_N VCC VEE OUTD LMC6482_SEC
.ENDS LMC6482

* ----------------------------------------------------------------
* LMC6492 — CMOS Rail-to-Rail Dual Op-Amp  (TI)  DIP-8, 2 sections
*   Avol≈84dB  GBW=1.5MHz  SR=2.7V/µs  Rin≈1TΩ  V+=2.7–16V
*
*   *** WARNING: NOT SUITABLE for standard ±12V Eurorack rails. ***
*   *** Maximum supply is ±8V (16V total).                       ***
*   *** Use only in 0–10V or low-voltage sub-sections.           ***
*
*   Source: Same silicon family as LMC6482; identical macro model.
* ----------------------------------------------------------------
.SUBCKT LMC6492_SEC 1 2 3 4 5
*                    IN+ IN- V+ V- OUT
*
C1   11 12 2.0E-12
C2    6  7 21.2E-12
DC    5 53 DX
DE   54  5 DX
DLP  90 91 DX
DLN  92 90 DX
DP    4  3 DX
EGND 99  0 VALUE = {0.5*V(3) + 0.5*V(4)}
FB1   7 99 VB  1.681E6
FB2   7 99 VC -20E6
FB3   7 99 VE  20E6
FB4   7 99 VLP 20E6
FB5   7 99 VLN -20E6
GA    6  0 11 12 200.0E-6
GCM   0  6 10 99 1.0E-12
IEE  10  4 DC 100.0E-6
HLIM 90  0 VLIM 1K
J1   11  2 13 JX
J2   12  1 14 JX
R2    6  9 100.0E3
RD1   3 11 5.0E3
RD2   3 12 5.0E3
RS1  13 10 2.0E3
RS2  14 10 2.0E3
RSS  10 99 5.0E6
RO1   8  5 75
RO2   7 99 25
RP    3  4 30.0E3
VB    9  0 DC 0
VC    3 53 DC 0.05
VE   54  4 DC 0.05
VLIM  7  8 DC 0
VLP  91  0 DC 20
VLN   0 92 DC 20
.MODEL DX D(IS=800.0E-18 RS=1)
.MODEL JX NJF(IS=12.50E-12 BETA=500E-6 VTO=-0.5)
.ENDS LMC6492_SEC

* LMC6492 package wrapper — dual, shared VCC/VEE
.SUBCKT LMC6492 VCC VEE INA_P INA_N OUTA INB_P INB_N OUTB
XA INA_P INA_N VCC VEE OUTA LMC6492_SEC
XB INB_P INB_N VCC VEE OUTB LMC6492_SEC
.ENDS LMC6492


* ================================================================
* SECTION 4: AUDIO AMPLIFIERS & PREAMPS
* ================================================================

* ----------------------------------------------------------------
* LM386 — Low-Voltage Audio Power Amplifier  (Texas Instruments)
*   Supply: 4–12V single-supply   Internal gain = 20x (pins 1,8 open)
*   Output: ~250mW into 8Ω        Output biased at VCC/2
*   Use: Lo-fi headphone output; "accursed" distortion/overdrive.
*
*   Pin mapping for this subcircuit:
*     1=IN+   2=IN-   3=V+   4=GND(V-)   5=OUT
*
*   To increase gain (up to 200x): connect a resistor and cap
*   from pin 1 to pin 8 externally (not modeled here; adjust
*   the EAMP polynomial coefficient manually if needed).
*
*   Source: Simplified behavioral subcircuit capturing key
*           characteristics: 50kΩ Rin, gain=20, VCC/2 bias,
*           ~100Ω Rout, output clamped to within 0.4V of rails.
* ----------------------------------------------------------------
.SUBCKT LM386 1 2 3 4 5
*              IN+ IN- V+ GND OUT
*
* 50 kΩ differential input impedance
RIN   1 2 50K
*
* VCC/2 bias network for output DC level (10kΩ:10kΩ divider)
RMID1 3 10 10K
RMID2 10 4 10K
CMID  10 4 100U
*
* VALUE: Vout_pre = 1*V(mid) + 20*(V(IN+) - V(IN-))
EAMP 20 0 VALUE = {V(10) + 20*(V(1) - V(2))}
*
* Output resistance (~100 Ω)
ROUT 20 5 100
*
* Output clamp: within 0.4V of supply rails
VCLPH 3 96 DC 0.4
VCLPL 97 4 DC 0.4
DCLPH 5 96 DCLAMP
DCLPL 97 5 DCLAMP
.MODEL DCLAMP D(IS=1E-14 RS=0.1)
.ENDS LM386

* ----------------------------------------------------------------
* TDA2030 — 14 W Hi-Fi Audio Amplifier  (STMicroelectronics)
*   Supply: up to 36V total, single or split supply, Pentawatt-5
*   Output: 14W typ into 4Ω at 14V / 0.5% THD; 12W guaranteed @ ±14V
*   Use: Speaker/headphone driver stages; utility power amplification.
*
*   Pin mapping for this library subcircuit:
*     1=IN+   2=IN-   3=V+   4=V-   5=OUT
*
*   Source: ST TDA2030 product page and datasheet for electrical envelope.
*           Public ST pages did not expose a downloadable SPICE macromodel
*           during this search. This implementation therefore wraps the
*           vendor-published TI LM1875 PSpice model (Rev. A, SNAM066) as a
*           documented proxy, because LM1875 is a similar 5-pin class-AB
*           audio power amplifier with comparable split-supply use.
* ----------------------------------------------------------------
.SUBCKT TDA2030 IN_P IN_N VCC VEE OUT
*              IN+  IN-  V+  V-  OUT
XCORE IN_N IN_P VEE VCC OUT LM1875TI_0
.ENDS TDA2030

* TI LM1875 vendor macromodel, namespaced for this combined library.
.SUBCKT LM1875TI_0 Vin Vip VSS VDD Vout
IS2         VDD 20 210N
IS3         19 VSS -190N
Vos         20 12 2M
XU4         GNDF VSS 8 9 GNDF LM1875TI_PSRR
+ PARAMS: PSRR=90 FPSRR=500
XU5         VDD GNDF 9 10 GNDF LM1875TI_PSRR
+ PARAMS: PSRR=95 FPSRR=20K
XU_VNOISE   11 12 LM1875TI_VNSE
+ PARAMS: NLF=10 FLW=4 NVR=3000
XU2         15 13 14 GNDF VDD LM1875TI_GBW_SLEW_SE
+ PARAMS: AOL=90 GBW=3.2G SRP=8MEG SRN=8MEG IT=1M VON=0.5 ROFF=1M
XU3         17 16 VDD LM1875TI_OUT_CURRENT_CLAMP_PD
+ PARAMS: RON=0.1 ROFF=100MEG VON=0.5 IMAX=2.65 IMIN=-2.65
XU_TF       14 18 GNDF LM1875TI_TF
+ PARAMS: FZ1=10G FZ2=10G FZ3=10G FZ4=10G FZ5=10G FP1=10E6 FP2=10G FP3=10G
+ FP4=10G
XU1         VDD VSS VDD LM1875TI_IQ_IOFF
+ PARAMS: VON=0.5 IQQ=35M IOFF=0.2M
XD4         VSS 19 LM1875TI_IDEAL_DIODE
+ PARAMS: EMCO=0.05 BRKV=60 IBRKV=1M
XD3         19 VDD LM1875TI_IDEAL_DIODE
+ PARAMS: EMCO=0.05 BRKV=60 IBRKV=1M
XD2         VSS 20 LM1875TI_IDEAL_DIODE
+ PARAMS: EMCO=0.05 BRKV=60 IBRKV=1M
XD1         20 VDD LM1875TI_IDEAL_DIODE
+ PARAMS: EMCO=0.05 BRKV=60 IBRKV=1M
XU_GND      VDD VSS GNDF LM1875TI_GND_FLOAT
XU6         16 Vout Vimon LM1875TI_AMETER
+ PARAMS: GAIN=1
XU7         VDD VSS Vimon GNDF LM1875TI_RAIL_CURRENT
+ PARAMS: SCALE=1
XU_CLAW     VDD VSS 18 17 Vimon GNDF LM1875TI_VCLAMP_W_SENSE
+ PARAMS: VMAXIO=6 VMINIO=6 SLOPE=0
XU2_VCLAMP  VDD VSS 19 13 GNDF LM1875TI_VCLAMP
+ PARAMS: VMAX=0.1 VMIN=0.1
XU1_VCLAMP  VDD VSS 20 15 GNDF LM1875TI_VCLAMP
+ PARAMS: VMAX=0.1 VMIN=0.1
XU_CMRR     10 19 GNDF LM1875TI_CMRR
+ PARAMS: CMRR=110 FCMRR=20
XUINPUT     Vip Vin 11 8 GNDF LM1875TI_INPUT
+ PARAMS: RCM=1 CCM=1000F CDM=100F
.ENDS LM1875TI_0

.SUBCKT LM1875TI_PSRR VDD VSS VI VO GNDF PARAMS: PSRR=130 FPSRR=1.6
.PARAM PI=3.141592
.PARAM RPSRR=1
.PARAM GPSRR={PWR(10,-PSRR/20)/RPSRR}
.PARAM LPSRR={RPSRR/(2*PI*FPSRR)}
G1  GNDF 1 VDD VSS {GPSRR}
R1  1 2 {RPSRR}
L1  2 GNDF {LPSRR}
E1  VO VI 1 GNDF 1
C2  VDD VSS 10P
.ENDS LM1875TI_PSRR

.SUBCKT LM1875TI_VNSE 1 2 PARAMS: NLF=10 FLW=4 NVR=4.6
.PARAM GLF={PWR(FLW,0.25)*NLF/1164}
.PARAM RNV={1.184*PWR(NVR,2)}
.MODEL LM1875TI_DVN D KF={PWR(FLW,0.5)/1E11} IS=1.0E-16
I1 0 7 10E-3
I2 0 8 10E-3
D1 7 0 LM1875TI_DVN
D2 8 0 LM1875TI_DVN
E1 3 6 7 8 {GLF}
R1 3 0 1E9
R2 3 0 1E9
R3 3 6 1E9
E2 6 4 5 0 10
R4 5 0 {RNV}
R5 5 0 {RNV}
R6 3 4 1E9
R7 4 0 1E9
E3 1 2 3 4 1
C1 1 0 1E-15
C2 2 0 1E-15
C3 1 2 1E-15
.ENDS LM1875TI_VNSE

.SUBCKT LM1875TI_GBW_SLEW_SE VIP VIM VO GNDF PD
+ PARAMS: AOL=100 GBW=1MEG SRP=1MEG SRN=1MEG IT=1M VON=0.5 ROFF=1M
.PARAM PI=3.141592
.PARAM IP={IT}
.PARAM IN={-IT}
.PARAM CC={IT/SRP}
.PARAM FP={GBW/PWR(10,AOL/20)}
.PARAM RC={1/(2*PI*CC*FP)}
.PARAM GC={PWR(10,AOL/20)/RC}
G1    GNDF VO VALUE={MAX(MIN(GC*V(VIP,VIM),IP),IN)}
C1    VO GNDF {CC}
GR1   VO GNDF VALUE={V(VO,GNDF)/RC}
GR11  VO GNDF VALUE={V(VO,GNDF)/(RC*100)}
.ENDS LM1875TI_GBW_SLEW_SE

.SUBCKT LM1875TI_OUT_CURRENT_CLAMP_PD IN OUT PD
+ PARAMS: RON=1 ROFF=1G VON=0.5 IMAX=10M IMIN=-10M
.PARAM IHALF={(IMAX-IMIN)/2}
.PARAM ICENTER={(IMAX+IMIN)/2}
GRES IN OUT VALUE={ICENTER + IHALF*TANH(V(IN,OUT)/(RON*IHALF))}
.ENDS LM1875TI_OUT_CURRENT_CLAMP_PD

.SUBCKT LM1875TI_TF VI VO GNDF
+ PARAMS: FZ1=10G FZ2=10G FZ3=10G FZ4=10G FZ5=10G FP1=1 FP2=10G FP3=10G FP4=10G
.PARAM GM=1M
.PARAM RO={1/GM}
.PARAM PI=3.141592
GP1  GNDF VP1 VI GNDF {GM}
GRP1 VP1 GNDF VALUE={V(VP1,GNDF)/RO}
CP1  VP1 GNDF {1/(2*PI*RO*FP1)}
GP2  GNDF VP2 VP1 GNDF {GM}
GRP2 VP2 GNDF VALUE={V(VP2,GNDF)/RO}
CP2  VP2 GNDF {1/(2*PI*RO*FP2)}
GP3  GNDF VP3 VP2 GNDF {GM}
GRP3 VP3 GNDF VALUE={V(VP3,GNDF)/RO}
CP3  VP3 GNDF {1/(2*PI*RO*FP3)}
GP4  GNDF VP4 VP3 GNDF {GM}
GRP4 VP4 GNDF VALUE={V(VP4,GNDF)/RO}
CP4  VP4 GNDF {1/(2*PI*RO*FP4)}
GZ1  GNDF VZ1 VP4 GNDF {GM}
GRZ1 VZ1 VX1 VALUE={V(VZ1,VX1)/RO}
LZ1  VX1 GNDF {RO/(2*PI*FZ1)}
GZ2  GNDF VZ2 VZ1 GNDF {GM}
GRZ2 VZ2 VX2 VALUE={V(VZ2,VX2)/RO}
LZ2  VX2 GNDF {RO/(2*PI*FZ2)}
GZ3  GNDF VZ3 VZ2 GNDF {GM}
GRZ3 VZ3 VX3 VALUE={V(VZ3,VX3)/RO}
LZ3  VX3 GNDF {RO/(2*PI*FZ3)}
GZ4  GNDF VZ4 VZ3 GNDF {GM}
GRZ4 VZ4 VX4 VALUE={V(VZ4,VX4)/RO}
LZ4  VX4 GNDF {RO/(2*PI*FZ4)}
GZ5  GNDF VO VZ4 GNDF {GM}
GRZ5 VO VX5 VALUE={V(VO,VX5)/RO}
LZ5  VX5 GNDF {RO/(2*PI*FZ5)}
.ENDS LM1875TI_TF

.SUBCKT LM1875TI_IQ_IOFF VDD VSS PD PARAMS: VON=0.5 IQQ=1M IOFF=1P
G1 VDD VSS VALUE={IQQ}
.ENDS LM1875TI_IQ_IOFF

.SUBCKT LM1875TI_IDEAL_DIODE A C PARAMS: EMCO=0.01 BRKV=60 IBRKV=1M
D1 A C LM1875TI_IDIODE
.MODEL LM1875TI_IDIODE D(N={EMCO} RS=10M CJO=1P TT=1N BV={BRKV} IBV={IBRKV})
.ENDS LM1875TI_IDEAL_DIODE

.SUBCKT LM1875TI_GND_FLOAT VDD VSS GNDF
EGNDF GNDF 0 VALUE={(V(VDD)+V(VSS))*0.5}
.ENDS LM1875TI_GND_FLOAT

.SUBCKT LM1875TI_AMETER VI VO VIMON PARAMS: GAIN=1
VSENSE VI VO DC 0
EMETER VIMON 0 VALUE={I(VSENSE)*GAIN}
.ENDS LM1875TI_AMETER

.SUBCKT LM1875TI_RAIL_CURRENT VDD VSS VIMON GNDF PARAMS: SCALE=1
.PARAM ISMOOTH=1U
GPOS VDD GNDF VALUE={(V(VIMON)*SCALE + SQRT((V(VIMON)*SCALE)^2 + ISMOOTH^2))/2}
GNEG GNDF VSS VALUE={(-V(VIMON)*SCALE + SQRT((V(VIMON)*SCALE)^2 + ISMOOTH^2))/2}
.ENDS LM1875TI_RAIL_CURRENT

.SUBCKT LM1875TI_VCLAMP_W_SENSE VDD VSS VI VO VIMON GNDF
+ PARAMS: VMAXIO=0.1 VMINIO=0.1 SLOPE=0
EPCLIP VDD_CLP 0 VALUE={V(VDD,GNDF) - SLOPE*V(VIMON) - VMAXIO}
ENCLIP VSS_CLP 0 VALUE={V(VSS,GNDF) - SLOPE*V(VIMON) + VMINIO}
ECLAMP VO GNDF VALUE={MAX(MIN(V(VI,GNDF), V(VDD_CLP)), V(VSS_CLP))}
.ENDS LM1875TI_VCLAMP_W_SENSE

.SUBCKT LM1875TI_VCLAMP VDD VSS VI VO GNDF PARAMS: VMAX=0.1 VMIN=0.1
ECLAMP VO GNDF VALUE={MAX(MIN(V(VI,GNDF), V(VDD,GNDF) - VMAX), V(VSS,GNDF) + VMIN)}
.ENDS LM1875TI_VCLAMP

.SUBCKT LM1875TI_CMRR VI VO GNDF PARAMS: CMRR=130 FCMRR=1.6K
.PARAM PI=3.141592
.PARAM RCMRR=1
.PARAM GCMRR={PWR(10,-CMRR/20)/RCMRR}
.PARAM LCMRR={RCMRR/(2*PI*FCMRR)}
G1  GNDF 1 VI GNDF {GCMRR}
R1  1 2 {RCMRR}
L1  2 GNDF {LCMRR}
E1  VI VO 1 GNDF 1
.ENDS LM1875TI_CMRR

.SUBCKT LM1875TI_INPUT VIP VIN VOP VON GNDF PARAMS: RCM=1 CCM=1000F CDM=100F
C1  VOP GNDF {CCM}
C2  VON GNDF {CCM}
C3  VOP VON {CDM}
G1  VIP VOP VALUE={V(VIP,VOP)/RCM}
G2  VIN VON VALUE={V(VIN,VON)/RCM}
.ENDS LM1875TI_INPUT

* ----------------------------------------------------------------
* NE5532 — Dual Low-Noise Op-Amp  (Texas Instruments)  DIP-8, 2 sections
*   Avol≈100dB  GBW=10MHz  SR=9V/µs  En=5nV/√Hz  Rails=±18V
*   Use: Audio mixers, output drivers, low-noise gain stages.
*   Source: Texas Instruments NE5534-derived NE5532 macromodel.
*           C2 is retained from the compensated TI macro model.
* ----------------------------------------------------------------
.SUBCKT NE5532_SEC 1 2 3 4 5
*                   IN+ IN- V+ V- OUT
*
C1   11 12 7.703E-12
C2    6  7 23.500E-12
DC    5 53 DX
DE   54  5 DX
DLP  90 91 DX
DLN  92 90 DX
DP    4  3 DX
EGND 99  0 VALUE = {0.5*V(3) + 0.5*V(4)}
FB1   7 99 VB  2.893E6
FB2   7 99 VC -3E6
FB3   7 99 VE  3E6
FB4   7 99 VLP 3E6
FB5   7 99 VLN -3E6
GA    6  0 11 12 1.382E-3
GCM   0  6 10 99 13.82E-9
IEE  10  4 DC 133.0E-6
HLIM 90  0 VLIM 1K
Q1   11  2 13 QX
Q2   12  1 14 QX
R2    6  9 100.0E3
RC1   3 11 723.3
RC2   3 12 723.3
RE1  13 10 329
RE2  14 10 329
REE  10 99 1.504E6
RO1   8  5 50
RO2   7 99 25
RP    3  4 7.757E3
VB    9  0 DC 0
VC    3 53 DC 2.700
VE   54  4 DC 2.700
VLIM  7  8 DC 0
VLP  91  0 DC 38
VLN   0 92 DC 38
.MODEL DX D(IS=800.0E-18)
.MODEL QX NPN(IS=800.0E-18 BF=132)
.ENDS NE5532_SEC

* NE5532 package wrapper — dual, shared VCC/VEE
.SUBCKT NE5532 VCC VEE INA_P INA_N OUTA INB_P INB_N OUTB
XA INA_P INA_N VCC VEE OUTA NE5532_SEC
XB INB_P INB_N VCC VEE OUTB NE5532_SEC
.ENDS NE5532

* NTE824 — Vetco alias for NE5532, same dual package wrapper
.SUBCKT NTE824 VCC VEE INA_P INA_N OUTA INB_P INB_N OUTB
XA INA_P INA_N VCC VEE OUTA NE5532_SEC
XB INB_P INB_N VCC VEE OUTB NE5532_SEC
.ENDS NTE824

* ----------------------------------------------------------------
* NTE983 — Dual Low-Noise Preamp  (TL072 equiv.)  DIP-8, 2 sections
*   Avol≈106dB  GBW=3MHz  SR=13V/µs  Rin≈10^12Ω  Rails=±18V
*   Use: Low-noise interface for guitars or microphones.
*   Source: Boyle macro model with JFET input stage (TL072 params).
*           GA/C2 set for 3MHz GBW; JFET pair for high-Z input.
* ----------------------------------------------------------------
.SUBCKT NTE983_SEC 1 2 3 4 5
*                   IN+ IN- V+ V- OUT
*
C1   11 12 3.498E-12
C2    6  7 10.00E-12
DC    5 53 DX
DE   54  5 DX
DLP  90 91 DX
DLN  92 90 DX
DP    4  3 DX
EGND 99  0 VALUE = {0.5*V(3) + 0.5*V(4)}
FB1   7 99 VB  21.22E6
FB2   7 99 VC -40E6
FB3   7 99 VE  40E6
FB4   7 99 VLP 40E6
FB5   7 99 VLN -40E6
GA    6  0 11 12 188.5E-6
GCM   0  6 10 99 1.0E-9
IEE  10  4 DC 200.0E-6
HLIM 90  0 VLIM 1K
J1   11  2 13 JX
J2   12  1 14 JX
R2    6  9 100.0E3
RD1   3 11 5.305E3
RD2   3 12 5.305E3
RS1  13 10 2.273E3
RS2  14 10 2.273E3
RSS  10 99 2.5E6
RO1   8  5 50
RO2   7 99 25
RP    3  4 18.0E3
VB    9  0 DC 0
VC    3 53 DC 1.5
VE   54  4 DC 1.5
VLIM  7  8 DC 0
VLP  91  0 DC 40
VLN   0 92 DC 40
.MODEL DX D(IS=800.0E-18 RS=1)
.MODEL JX NJF(IS=12.50E-12 BETA=250E-6 VTO=-1)
.ENDS NTE983_SEC

* NTE983 package wrapper — dual, shared VCC/VEE
.SUBCKT NTE983 VCC VEE INA_P INA_N OUTA INB_P INB_N OUTB
XA INA_P INA_N VCC VEE OUTA NTE983_SEC
XB INB_P INB_N VCC VEE OUTB NTE983_SEC
.ENDS NTE983


