+ BR=5.458      NC=2     ISC=0    IKR=0
+ RC=0.248      CJC=26p  VJC=0.4   MJC=0.368   FC=0.5
+ CJE=27.3p     VJE=0.721 MJE=0.85
+ TR=100n       TF=644p  ITF=1.201 VTF=0.345  XTF=1.432  RB=5.747 )

